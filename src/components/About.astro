---
const skillGroups = [
	{
		label: "Front-end",
		items: ["React", "Next.js", "Astro.js", "Flutter", "JavaScript", "HTML/CSS", "Figma"],
	},
	{
		label: "Back-end",
		items: ["PHP", "Symfony", "Node.js", "Express.js", "API REST", "WebSockets", "SQL", "MongoDB"],
	},
	{
		label: "IA / Agentique",
		items: ["Claude Code", "Gemini", "Codex", "Claude Skills"],
	},
	{
		label: "Outils",
		items: ["Git / GitHub", "Docker", "Postman", "Trello", "Jira", "Notion", "VS Code", "Cursor"],
	},
];

const education = [
	{
		title: "Mastère Dev Manager Fullstack",
		place: "EFREI Paris",
		period: "2024 → 2026",
	},
	{
		title: "Bachelor Concepteur Développeur d'Applications",
		place: "EPSI Paris",
		period: "2021 → 2024",
	},
];

const languages = [
	{ name: "Français", level: "Natif", pct: 100 },
	{ name: "Anglais", level: "Technique / Intermédiaire", pct: 65 },
];
---

<section class="about" id="about">
	<div class="container">
		<p class="section-tag">01 · Profil</p>
		<h2 class="section-title">À propos <span>de moi</span></h2>

		<div class="about-grid">
			<div class="about-text" data-reveal>
				<p>
					Développeur Full Stack de 22 ans basé en France, je conçois des
					applications web et mobile complètes, de l'architecture back-end à
					l'interface finale. J'interviens aussi bien sur des SaaS
					(<span class="hl mark">oonecard.com</span>), des sites vitrines animés
					(<span class="hl mark">weseepub.com</span>) que des applications mobiles
					connectées à des API métier.
				</p>
				<p>
					J'utilise activement les outils IA/agentiques (Claude Code, Cursor,
					Gemini) pour accélérer le développement, automatiser les tâches
					répétitives et livrer plus vite sans sacrifier la qualité.
				</p>

				<div class="edu">
					{education.map((e) => (
						<div class="edu-item">
							<span class="edu-period mono">{e.period}</span>
							<div>
								<p class="edu-title">{e.title}</p>
								<p class="edu-place">{e.place}</p>
							</div>
						</div>
					))}
				</div>

				<div class="languages">
					{languages.map((l) => (
						<div class="lang-row">
							<div class="lang-head mono">
								<span>{l.name}</span>
								<span>{l.level}</span>
							</div>
							<div class="lang-bar">
								<div class="lang-fill" style={`width:${l.pct}%`}></div>
							</div>
						</div>
					))}
				</div>
			</div>

			<div class="skills" data-reveal>
				{skillGroups.map((group) => (
					<div class="skill-card">
						<p class="skill-label mono">{group.label}</p>
						<div class="skill-tags">
							{group.items.map((item) => (
								<span>{item}</span>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.about {
		position: relative;
		z-index: 1;
		padding: 7rem 0;
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 3.5rem;
	}

	.about-text p {
		color: var(--text-dim);
		line-height: 1.75;
		margin-bottom: 1.2rem;
		font-size: 0.98rem;
	}

	.hl {
		font-family: var(--font-mono);
		font-size: 0.9em;
	}

	.edu {
		margin-top: 2.2rem;
		padding-top: 1.8rem;
		border-top: 1px solid var(--panel-border);
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}

	.edu-item {
		display: flex;
		gap: 1.2rem;
		align-items: baseline;
	}

	.edu-period {
		font-size: 0.72rem;
		color: var(--text-faint);
		white-space: nowrap;
		min-width: 90px;
	}

	.edu-title {
		font-size: 0.92rem;
		font-weight: 600;
	}

	.edu-place {
		font-size: 0.82rem;
		color: var(--text-faint);
	}

	.languages {
		margin-top: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.lang-head {
		display: flex;
		justify-content: space-between;
		font-size: 0.72rem;
		color: var(--text-faint);
		margin-bottom: 0.4rem;
	}

	.lang-bar {
		height: 4px;
		border-radius: 4px;
		background: var(--panel-border);
		overflow: hidden;
	}

	.lang-fill {
		height: 100%;
		background: linear-gradient(90deg, var(--accent), var(--accent-2));
	}

	.skills {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.skill-card {
		border: 1px solid var(--panel-border);
		background: rgba(13, 18, 32, 0.5);
		border-radius: 14px;
		padding: 1.3rem 1.4rem;
		transition: border-color 0.25s ease, transform 0.25s ease;
	}

	.skill-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}

	.skill-label {
		font-size: 0.72rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 0.9rem;
	}

	.skill-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.skill-tags span {
		font-size: 0.78rem;
		color: var(--text-dim);
		background: var(--bg-soft);
		border: 1px solid var(--panel-border);
		padding: 0.35rem 0.7rem;
		border-radius: 6px;
	}

	@media (max-width: 900px) {
		.about-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
