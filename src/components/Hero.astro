---
---

<section class="hero" id="top">
	<div class="container hero-inner">
		<div class="hero-main">
			<h1 class="title">
				<span class="line-mask" data-hero-line><span class="mark">Lux VEGBA</span></span>
				<span class="line-mask" data-hero-line><span class="mark">Développeur Full Stack</span></span>
			</h1>

			<p class="subtitle" data-hero-fade>
				JavaScript &amp; PHP : je conçois et développe des applications web et
				mobile de bout en bout, de la maquette Figma à la mise en production.
				React, Next.js, Astro.js, Symfony, Node.js.
			</p>

			<div class="actions" data-hero-fade>
				<a href="#projects" class="btn primary">Voir mes projets</a>
				<a href="/CV_Lux_VEGBA.pdf" class="btn ghost mono" download>↓ Télécharger le CV</a>
			</div>

			<div class="stack" data-hero-fade>
				<span class="stack-label mono">STACK</span>
				<div class="stack-list mono">
					<span>React</span>
					<span>Next.js</span>
					<span>Astro.js</span>
					<span>Node.js</span>
					<span>Symfony</span>
					<span>MongoDB</span>
					<span>Flutter</span>
				</div>
			</div>
		</div>

		<div class="hero-photo" data-hero-fade>
			<span class="photo-glow" aria-hidden="true"></span>
			<span class="photo-corner tl" aria-hidden="true"></span>
			<span class="photo-corner br" aria-hidden="true"></span>
			<div class="photo-frame">
				<img src="/lux-photo.png" alt="Portrait de Lux VEGBA" />
			</div>
			<div class="photo-card mono">
				<span class="card-dot"></span>
				22 ans · France
			</div>
		</div>
	</div>

	<a href="#about" class="scroll-hint mono" aria-label="Défiler vers le bas">
		<span>scroll</span>
		<span class="scroll-line"></span>
	</a>
</section>

<style>
	.hero {
		position: relative;
		z-index: 1;
		min-height: 100svh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-top: 6rem;
		padding-bottom: 4rem;
	}

	.hero-inner {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 4rem;
	}

	.hero-main {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		min-width: 0;
	}

	.title {
		font-size: clamp(2.4rem, 6.5vw, 4.4rem);
		font-weight: 700;
		line-height: 1.28;
		letter-spacing: -0.02em;
		margin-bottom: 1.8rem;
	}

	.line-mask {
		display: block;
		overflow: hidden;
	}

	.mark {
		line-height: 1.3;
	}

	.subtitle {
		max-width: 600px;
		font-size: clamp(1rem, 1.6vw, 1.15rem);
		color: var(--text-dim);
		line-height: 1.65;
		margin-bottom: 2.4rem;
	}

	.actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 3.5rem;
	}

	.btn {
		padding: 0.9rem 1.6rem;
		border-radius: 10px;
		font-size: 0.9rem;
		font-weight: 600;
		transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, border-color 0.2s ease;
	}

	.btn.primary {
		background: var(--accent);
		color: #05070d;
	}
	.btn.primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 30px -10px var(--accent);
	}

	.btn.ghost {
		border: 1px solid var(--panel-border);
		color: var(--text);
	}
	.btn.ghost:hover {
		border-color: var(--accent);
		color: var(--accent);
		transform: translateY(-2px);
	}

	.stack {
		display: flex;
		align-items: center;
		gap: 1.2rem;
		flex-wrap: wrap;
		padding-top: 1.8rem;
		border-top: 1px solid var(--panel-border);
		width: 100%;
	}

	.stack-label {
		font-size: 0.72rem;
		letter-spacing: 0.2em;
		color: var(--text-faint);
	}

	.stack-list {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.stack-list span {
		font-size: 0.78rem;
		color: var(--text-dim);
		border: 1px solid var(--panel-border);
		padding: 0.35rem 0.7rem;
		border-radius: 6px;
	}

	/* Photo */
	.hero-photo {
		position: relative;
		display: flex;
		justify-self: end;
		padding: 1.2rem;
	}

	.photo-glow {
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at 50% 25%, rgba(79, 139, 255, 0.35), transparent 65%);
		filter: blur(36px);
		z-index: -1;
	}

	.photo-frame {
		position: relative;
		width: clamp(210px, 21vw, 290px);
		aspect-ratio: 4 / 5;
		border-radius: 18px;
		overflow: hidden;
		border: 1px solid var(--panel-border);
		box-shadow: 0 30px 70px -25px rgba(0, 0, 0, 0.75);
	}

	.photo-frame::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: 18px;
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
		pointer-events: none;
	}

	.photo-frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(1.05) contrast(1.03);
	}

	.photo-corner {
		position: absolute;
		width: 26px;
		height: 26px;
		border: 2px solid var(--accent);
		opacity: 0.7;
	}
	.photo-corner.tl {
		top: 0;
		left: 0;
		border-right: none;
		border-bottom: none;
		border-top-left-radius: 6px;
	}
	.photo-corner.br {
		bottom: 0;
		right: 0;
		border-left: none;
		border-top: none;
		border-bottom-right-radius: 6px;
	}

	.photo-card {
		position: absolute;
		left: 0.2rem;
		bottom: -0.5rem;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		color: var(--text);
		border: 1px solid var(--panel-border);
		padding: 0.55rem 1rem;
		border-radius: 999px;
		background: rgba(10, 14, 24, 0.85);
		backdrop-filter: blur(8px);
		box-shadow: 0 12px 30px -12px rgba(0, 0, 0, 0.6);
	}

	.card-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 8px var(--accent);
	}

	@media (max-width: 860px) {
		.hero-inner {
			grid-template-columns: 1fr;
		}
		.hero-photo {
			justify-self: start;
			order: -1;
			margin-bottom: 1rem;
		}
		.photo-frame {
			width: clamp(160px, 45vw, 220px);
		}
	}

	.scroll-hint {
		position: absolute;
		bottom: 2rem;
		right: 3rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.7rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--text-faint);
	}

	.scroll-line {
		width: 1px;
		height: 40px;
		background: linear-gradient(to bottom, var(--accent), transparent);
	}

	@media (max-width: 720px) {
		.scroll-hint {
			display: none;
		}
	}
</style>
