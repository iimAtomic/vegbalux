---
const links = [
	{ label: "Email", value: "vegbahermerite@gmail.com", href: "mailto:vegbahermerite@gmail.com" },
	{ label: "Téléphone", value: "06 16 47 59 02", href: "tel:+33616475902" },
	{ label: "LinkedIn", value: "linkedin.com/in/vegbalux", href: "https://linkedin.com/in/vegbalux" },
];
---

<section class="contact" id="contact">
	<div class="container">
		<div class="panel" data-reveal>
			<p class="section-tag">04 · Contact</p>
			<h2 class="title">
				Construisons quelque chose <span>ensemble</span>.
			</h2>
			<p class="text">
				Disponible pour des missions freelance, une alternance ou un poste de
				développeur full stack. Basé en France, réponse rapide garantie.
			</p>

			<div class="links">
				{links.map((l) => (
					<a href={l.href} class="link-row" target={l.label === "LinkedIn" ? "_blank" : undefined} rel="noopener noreferrer">
						<span class="link-label mono">{l.label}</span>
						<span class="link-value">{l.value}</span>
						<span class="link-arrow">↗</span>
					</a>
				))}
			</div>
		</div>
	</div>

	<footer class="footer">
		<div class="container footer-inner">
			<p class="mono">© {new Date().getFullYear()} Lux VEGBA</p>
			<p class="mono">Développé avec Astro · GSAP · Three.js</p>
		</div>
	</footer>
</section>

<style>
	.contact {
		position: relative;
		z-index: 1;
		padding: 6rem 0 0;
	}

	.panel {
		border: 1px solid var(--panel-border);
		background: linear-gradient(180deg, rgba(13, 18, 32, 0.7), rgba(10, 14, 24, 0.4));
		border-radius: 20px;
		padding: clamp(2rem, 5vw, 4rem);
	}

	.title {
		font-size: clamp(1.9rem, 4.5vw, 3rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		max-width: 640px;
		margin-bottom: 1.2rem;
	}

	.title span {
		color: var(--accent);
	}

	.text {
		color: var(--text-dim);
		max-width: 480px;
		line-height: 1.65;
		margin-bottom: 2.6rem;
	}

	.links {
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--panel-border);
	}

	.link-row {
		display: grid;
		grid-template-columns: 120px 1fr 24px;
		align-items: center;
		padding: 1.3rem 0;
		border-bottom: 1px solid var(--panel-border);
		transition: color 0.2s ease, padding-left 0.2s ease;
	}

	.link-row:hover {
		color: var(--accent);
		padding-left: 0.5rem;
	}

	.link-label {
		font-size: 0.72rem;
		color: var(--text-faint);
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.link-value {
		font-size: 1.05rem;
		font-weight: 500;
	}

	.link-arrow {
		font-size: 1rem;
		color: var(--text-faint);
	}

	.footer {
		margin-top: 4rem;
		padding: 2rem 0 2.5rem;
	}

	.footer-inner {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-size: 0.72rem;
		color: var(--text-faint);
	}

	@media (max-width: 560px) {
		.link-row {
			grid-template-columns: 1fr auto;
			row-gap: 0.3rem;
		}
		.link-arrow {
			display: none;
		}
	}
</style>
